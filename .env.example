# Copiar a .env.local (no se sube al repo) para desarrollo local, y cargar las mismas dos
# variables en Vercel → Project Settings → Environment Variables para producción.
# Los valores salen de un proyecto de Supabase en Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
