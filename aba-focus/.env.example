# Copy to .env.local (not committed) for local development, and set the same two variables
# in Vercel → Project Settings → Environment Variables for production.
# Values come from a Supabase project → Project Settings → API.
# If they are missing, the app runs in DEMO mode: data is saved only in this browser.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
